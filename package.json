{
  "name": "amplifier-app-studio",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "release:check": "node scripts/check-release-version.mjs",
    "preview": "vite preview",
    "web:bridge": "cargo run --manifest-path src-tauri/Cargo.toml --bin amplifier-studio-server",
    "web:serve": "npm run build && npm run web:bridge",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "macos:build:signed": "./scripts/build-macos-signed.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.7",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.4"
  }
}

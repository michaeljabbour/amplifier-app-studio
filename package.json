{
  "name": "amplifier-app-studio",
  "private": true,
  "version": "0.1.67",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && npm run test:release",
    "test:release": "node --test scripts/*.node-test.mjs",
    "build": "npm run typecheck && vite build",
    "release:check": "node scripts/check-release-version.mjs",
    "preview": "vite preview",
    "web:bridge": "cargo run --manifest-path src-tauri/Cargo.toml --bin amplifier-host",
    "web:serve": "npm run build && npm run web:bridge",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "macos:build:peer-qa": "tauri build --debug --bundles app --config src-tauri/tauri.peer-qa.conf.json",
    "macos:build:real-window-smoke": "VITE_STUDIO_REAL_WINDOW_SMOKE=1 tauri build --debug --bundles app --config src-tauri/tauri.peer-qa.conf.json",
    "macos:build:signed": "./scripts/build-macos-signed.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@viz-js/viz": "^3.29.0",
    "dompurify": "^3.4.14",
    "lucide-solid": "^1.33.0",
    "marked": "^18.0.10",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.10"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amplifier Studio",
  "version": "0.1.8",
  "identifier": "com.amplifier.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Amplifier Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBMkQxRTM5OEJCMEQwNwpSV1FIRGJ1WTQ5R2lDNU9JOUJXMFlPczFtc3BWSDM0UlBsTk5CRkNyKyt4dldzQ1Zxb2RFWXJHUQo=",
      "endpoints": [
        "https://github.com/michaeljabbour/amplifier-app-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
